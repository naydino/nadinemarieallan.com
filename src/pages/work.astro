---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    year: 'ongoing',
    projects: [
      { title: 'studio work', slug: 'studio-work', medium: 'fine-art', venue: '', yearLabel: 'ongoing', image: '/images/fine-art/soft%20sculptures/IMG_0760.jpg', live: true },
    ],
  },
  {
    year: '2026',
    projects: [
      { title: 'Baroque Karaoke', slug: 'baroque-karaoke', medium: 'interactive-systems', venue: '', image: '/images/baroque-karaoke/thumb.jpg', live: true },
      { title: 'The Oracle That Wears Us', slug: 'oracle', medium: 'installation', venue: 'IADE', image: '/images/oracle/oracle_installation_room.png', live: true },
    ],
  },
  {
    year: '2025',
    projects: [
      { title: 'Echo Garden', slug: 'echo-garden', medium: 'generative-media', venue: 'IADE – Universidade Europeia', image: '/images/echo-garden/hero.jpg', live: true },
      { title: 'Room Tone (For Two)', slug: 'room-tone-for-two', medium: 'experimental-multimedia', venue: 'Cucalorus Film Festival', image: '/images/snakeskin/IMG_5543.jpg', live: true },
      { title: 'with Dream Video Division', slug: 'dream-video-division', medium: 'video-performance', venue: '', yearLabel: '2021–2025', image: '/images/metropolis/IMG_0530.JPG', live: true },
    ],
  },
  {
    year: '2022',
    projects: [
      { title: 'Sharper Teeth (AR installation)', slug: 'nosfera2', medium: 'installation', venue: 'Overlook Film Festival', image: '/images/nosfera2/IMG_8685.JPG', live: true },
    ],
  },
  {
    year: '2021',
    projects: [
      { title: '#0000FF Velvet', slug: 'velvet', medium: 'installation', venue: 'Cucalorus Film Festival', image: '/images/velvet/IMG_0075.jpg', live: true },
      { title: 'Paper Trail', slug: 'paper-trail', medium: 'installation', venue: 'Cucalorus Film Festival', image: '/images/velvet/8613B089-99ED-43F3-A72E-4778BBA2A50C.jpg', live: true },
      { title: 'Untitled Walk', slug: 'untitled-walk', medium: 'installation', venue: 'Spring Street Studio', image: '/images/Untitled_walk_april_2021/IMG_9717.jpg', live: true },
      { title: 'Audio/Visual Explorations', slug: 'digital-debris', medium: 'video-performance', venue: 'Digital Debris Gallery', image: '/images/digital-debris/60FC88AD-A873-4275-B0B4-1F003B61B431.jpg', live: true },
    ],
  },
];
---

<BaseLayout title="work">
  <section class="work">
    <div class="work-groups">
      {groups.map((group) => (
        <div class="year-group" data-year={group.year}>
          <div class="year-header">
            <span class="eyebrow year-eyebrow">{group.year}</span>
          </div>
          <div class="cells-grid">
            {group.projects.map((project) => (
              project.live ? (
                <a
                  href={`/work/${project.slug}`}
                  class="project-cell"
                  data-medium={project.medium}
                >
                  <div class="cell-image">
                    <img src={project.image} alt={project.title} class="cell-img" loading="lazy" onerror="this.style.display='none'" />
                  </div>
                  <div class="cell-meta">
                    <span class="year-label">{project.yearLabel || group.year}</span>
                    <div class="cell-title display-lg">{project.title}</div>
                    <div class="cell-venue">{project.venue}</div>
                    <div class="cell-tags">
                      <span class="tag">{project.medium.replace(/-/g, ' ')}</span>
                    </div>
                  </div>
                </a>
              ) : (
                <div
                  class="project-cell no-link"
                  data-medium={project.medium}
                >
                  <div class="cell-image">
                    <img src={project.image} alt={project.title} class="cell-img" loading="lazy" onerror="this.style.display='none'" />
                  </div>
                  <div class="cell-meta">
                    <span class="year-label">{project.yearLabel || group.year}</span>
                    <div class="cell-title display-lg">{project.title}</div>
                    <div class="cell-venue">{project.venue}</div>
                    <div class="cell-tags">
                      <span class="tag">{project.medium.replace(/-/g, ' ')}</span>
                    </div>
                    <div class="cell-coming-soon">page coming soon</div>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-padding-x) var(--space-7);
  }

  .year-group {
    margin-bottom: var(--space-5);
  }
  .year-header {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .year-eyebrow {
    color: var(--muted);
  }

  .cells-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4) var(--space-3);
  }
  @media (min-width: 1280px) {
    .cells-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 900px) {
    .cells-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .project-cell {
    display: block;
    text-decoration: none;
    transition: transform var(--transition-base);
  }
  .project-cell:not(.no-link):hover {
    transform: translateY(-3px);
  }
  .no-link {
    cursor: default;
  }
  .cell-image {
    background: var(--surface);
    overflow: hidden;
    margin-bottom: var(--space-2);
    aspect-ratio: 4 / 5;
  }
  .cell-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cell-meta {
    padding: 0 2px;
  }
  .year-label {
    display: block;
    margin-bottom: 4px;
  }
  .cell-title {
    color: var(--ink);
    transition: color var(--transition-base);
    margin: 0;
  }
  .project-cell:not(.no-link):hover .cell-title {
    color: var(--gold);
  }
  .cell-venue {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--w-light);
    color: var(--muted);
    margin-top: 4px;
  }
  .cell-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }
  .cell-coming-soon {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--w-light);
    color: var(--muted);
    letter-spacing: var(--ls-base);
    margin-top: 6px;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .work {
      padding: var(--space-5) var(--page-padding-x-sm) var(--space-6);
    }
    .cells-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
