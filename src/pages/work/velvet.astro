---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Stills only for now. Two .mov files (IMG_0100, IMG_0104) live in public/images/velvet/
// alongside their still counterparts; following the Nosfera2 precedent, video integration
// waits for Vimeo. Note: this was one of two installations Nadine built for Cucalorus 2021,
// see /work/paper-trail for the other (rice-paper forms, detective-film projection mapping).
---

<BaseLayout title="#0000FF Velvet" description="An indigo-dyed robe, named for David Lynch's Blue Velvet, hung from a tree and doubled as a tent visitors could step inside to meditate on ambient sound and projected light. Made with Racer Trash for Cucalorus Film Festival, 2021.">
  <article class="project">

    <header class="project-header">
      <span class="eyebrow">installation · 2021</span>
      <h1 class="display-xl project-title">#0000FF Velvet</h1>
    </header>

    <div class="hero-image">
      <img
        src="/images/velvet/IMG_0075.jpg"
        alt="Indigo-dyed robe hung from a tree, doubling as a tent, projected color visible inside"
        class="hero-img"
        onerror="this.style.display='none'"
      />
    </div>

    <div class="project-body">

      <p class="lead">
        #0000FF is a hex code: the flattest blue a screen can render, no texture, no batch variation. What hangs here is dyed indigo instead: vat-fermented, oxidized in open air, no two folds landing on quite the same value. Built with Racer Trash for Cucalorus Film Festival, 2021, and named for David Lynch's Blue Velvet, the robe hung from a tree and doubled as a tent, sleeves closed overhead like a roof, the body a room visitors could step into, alone or together, to sit with ambient sound and shifting projected light.
      </p>

      <blockquote class="pull-quote">
        A hex code is exact. Indigo never is.
      </blockquote>

      <div class="project-image">
        <img
          src="/images/velvet/1A0E5F07-2C5F-4948-92B5-AFCB4F97C6FE.jpg"
          alt="A visitor inside the indigo tent, projected color lighting the interior"
          class="content-img"
          onerror="this.style.display='none'"
        />
      </div>

      <p>
        It was one of two installations built for Cucalorus that year. The other hung rice-paper forms overhead instead of fabric, threaded with fragments of a detective film, answering footsteps rather than voice: <a href="/work/paper-trail" class="cta-link">see Paper Trail →</a>
      </p>

    </div>

    <div class="project-meta">
      <div class="meta-row">
        <span class="meta-label eyebrow">year</span>
        <span class="meta-value">2021</span>
      </div>
      <div class="meta-row">
        <span class="meta-label eyebrow">medium</span>
        <span class="meta-value">installation: indigo-dyed textile, projection mapping, audio-reactive</span>
      </div>
      <div class="meta-row">
        <span class="meta-label eyebrow">venue</span>
        <span class="meta-value">Cucalorus Film Festival, Wilmington NC · 2021</span>
      </div>
      <div class="meta-row">
        <span class="meta-label eyebrow">collaborators</span>
        <span class="meta-value">Racer Trash</span>
      </div>
    </div>

  </article>
</BaseLayout>

<style>
  .project {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-padding-x) var(--space-8);
  }

  .project-header {
    margin-bottom: var(--space-5);
  }
  .project-title {
    margin-top: var(--space-2);
  }

  .hero-image {
    background: var(--surface);
    margin-bottom: var(--space-6);
    min-height: 340px;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-body {
    margin-bottom: var(--space-7);
  }
  .lead {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: var(--w-light);
    line-height: var(--lh-body);
    color: var(--mid);
    margin-bottom: var(--space-3);
  }
  p {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--w-light);
    line-height: var(--lh-body);
    color: var(--mid);
    margin-bottom: var(--space-3);
  }

  .project-image {
    background: var(--surface);
    border: 1px solid var(--border);
    margin: var(--space-4) 0;
    overflow: hidden;
  }
  .content-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-meta {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
  }
  .meta-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .meta-label {
    color: var(--gold);
    align-self: start;
    padding-top: 2px;
  }
  .meta-value {
    font-weight: var(--w-light);
    color: var(--mid);
    line-height: var(--lh-body);
  }

  @media (max-width: 600px) {
    .project {
      padding: var(--space-5) var(--page-padding-x-sm) var(--space-7);
    }
    .meta-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
