---
import BaseLayout from '../../layouts/BaseLayout.astro';
const IMG = '/images/oracle/exhibition';
---

<BaseLayout title="The Oracle That Wears Us" description="An interactive AI installation. An oracle woven from moving thread listens to how you speak, shows you how it sees you, and has a robotic plotter draw your mark onto a collective cloth.">
  <canvas class="op-page-threads" aria-hidden="true"></canvas>
  <article class="project op">

    <header class="project-header">
      <span class="eyebrow">interactive installation · 2026</span>
      <h1 class="display-xl project-title">The Oracle That Wears Us</h1>
    </header>

    <div class="op-hero">
      <canvas class="op-hero-threads" aria-hidden="true"></canvas>
      <div class="op-hero-inner">
        <div class="op-hero-text">
          <p class="op-hero-lede">An oracle woven from moving thread. It listens to how you speak, shows you how it sees you, and has a machine draw your mark onto a cloth shared by every visitor.</p>
          <div class="op-hero-meta">
            <span>Interactive installation · 2026</span>
            <span><b>Exhibited</b> PROTO 26 · IADE Fashion Show · Oriente Green Campus, Lisbon · 25.09.2026</span>
            <span>Nadine Allan · Andrey Dyakov</span>
          </div>
        </div>
      <video id="heroVid" src={`${IMG}/idle_loop.mp4`} poster={`${IMG}/idle_loop_poster.jpg`} autoplay muted loop playsinline preload="metadata" aria-label="The oracle, a figure made of moving threads, waiting"></video>
      </div>
    </div>

    <div class="project-body">

      <!-- EXHIBITION -->
      <section id="exhibition">
        <div class="section-divider"><span class="eyebrow">proto 26, lisbon</span></div>
        <p class="lead">
          An interactive installation at PROTO 26, IADE's fashion show in Lisbon, on 25 September 2026. We built an agentic AI pipeline that listens to each visitor, assigns them a symbol, and has a robotic plotter draw it, so that over one evening the visitors design a collective cloth together.
        </p>
        <p>
          Two screens stood side by side: an animated flyer that explained the work to anyone passing, and the oracle itself. Beside them the plotter drew each new mark onto a long strip of fabric, next to a screen showing the cloth growing online.
        </p>

        <div class="op-gallery">
          <figure class="g-w op-rv"><img src={`${IMG}/cloth_under_screens.jpg`} alt="The installation at PROTO 26: the flyer screen and the oracle screen above a long cloth covered in drawn symbols" loading="lazy" style="object-position: center 62%" /><figcaption class="caption">the flyer, the oracle, and the cloth at the end of the night</figcaption></figure>
          <figure class="g-a op-rv"><video src={`${IMG}/clip_plotter_drawing.mp4`} poster={`${IMG}/clip_plotter_drawing_poster.jpg`} muted loop playsinline preload="none" data-auto aria-label="The plotter drawing a visitor's mark"></video><figcaption class="caption">the plotter drawing a visitor's mark</figcaption></figure>
          <figure class="g-b op-rv"><img src={`${IMG}/cloth_close.jpg`} alt="Close-up of the cloth: overlapping spirals, wheels and zigzags in black pen" loading="lazy" /><figcaption class="caption">marks overlapping on the cloth</figcaption></figure>
          <figure class="g-b op-rv"><img src={`${IMG}/receipt_screen.jpg`} alt="The receipt screen with the visitor's portrait, their symbol and the measured values" loading="lazy" /><figcaption class="caption">the receipt</figcaption></figure>
          <figure class="g-c op-rv"><img src={`${IMG}/cloth_full.jpg`} alt="The plotter above a full stretch of cloth" loading="lazy" /><figcaption class="caption">the cloth, filling up</figcaption></figure>
          <figure class="g-c op-rv"><video src={`${IMG}/clip_flyer_voice.mp4`} poster={`${IMG}/clip_flyer_voice_poster.jpg`} muted loop playsinline preload="none" data-auto aria-label="The flyer screen drawing a mark"></video><figcaption class="caption">the flyer screen, drawing a mark</figcaption></figure>
          <figure class="g-c op-rv"><img src={`${IMG}/begin_screen.jpg`} alt="The oracle screen waiting, with a BEGIN button" loading="lazy" /><figcaption class="caption">waiting for someone to arrive</figcaption></figure>
          <figure class="g-c op-rv"><img src={`${IMG}/nadine_selfie.jpg`} alt="Nadine Allan next to the oracle screen" loading="lazy" /><figcaption class="caption">with the oracle</figcaption></figure>
          <figure class="g-c op-rv"><video src={`${IMG}/clip_plotter_moving.mp4`} poster={`${IMG}/clip_plotter_moving_poster.jpg`} muted loop playsinline preload="none" data-auto aria-label="The plotter moving, pen down"></video><figcaption class="caption">pen down</figcaption></figure>
          <figure class="g-c op-rv"><img src={`${IMG}/cloth_online.jpg`} alt="The online collective cloth: a grid of 124 published marks" loading="lazy" style="object-position: top" /><figcaption class="caption">the collective cloth online, 124 marks</figcaption></figure>
        </div>
        <p class="op-small">Every mark is archived online: <a class="inline" href="https://berlogabob.github.io/OracleGallery/">the collective cloth</a></p>
      </section>

      <!-- ENCOUNTER -->
      <section id="encounter">
        <div class="section-divider"><span class="eyebrow">the encounter</span></div>
        <h2 class="display-lg op-h2">Four questions. A machine that reveals how it interprets you.</h2>
        <div class="op-session">
          <div class="op-vid op-rv">
            <video id="sessionVid" src={`${IMG}/session_edit.mp4`} poster={`${IMG}/session_edit_poster.jpg`} muted loop playsinline preload="metadata" data-auto aria-label="A full Oracle session filmed at the exhibition, edited to 74 seconds"></video>
            <button class="btn op-sound" id="soundBtn" type="button">sound off · tap for sound</button>
          </div>
          <div class="op-summary op-rv">
            <p>A century ago, travelling workers are said to have left chalk codes for the strangers who came after them. Oracle carries that habit into a time of AI: a figure woven from moving thread speaks with one visitor at a time and leaves their mark on a cloth shared by everyone.</p>
            <ul class="op-features">
              <li><b>Four spoken exchanges</b> with a language model that runs on the installation itself. Nothing you say leaves the room.</li>
              <li><b>Your voice, not your words,</b> chooses one of eight marks.</li>
              <li><b>An AI portrait</b> dresses you as a traveller of the road, holding the object you named, and weaves your face into the oracle's.</li>
              <li><b>A rescued plotter</b> draws your mark onto the collective cloth, which is archived online.</li>
            </ul>
            <p class="caption">one session at the exhibition, cut from three and a half minutes.</p>
          </div>
        </div>

        <div class="op-trio">
          <figure class="op-rv"><video src={`${IMG}/oracle_to_visitor_pizza.mp4`} poster={`${IMG}/oracle_to_visitor_pizza_poster.jpg`} muted loop playsinline preload="none" data-auto></video><figcaption class="caption">named object: a slice of pizza</figcaption></figure>
          <figure class="op-rv"><video src={`${IMG}/oracle_to_visitor_rock.mp4`} poster={`${IMG}/oracle_to_visitor_rock_poster.jpg`} muted loop playsinline preload="none" data-auto></video><figcaption class="caption">named object: a rock</figcaption></figure>
          <figure class="op-rv"><video src={`${IMG}/oracle_to_visitor_fork.mp4`} poster={`${IMG}/oracle_to_visitor_fork_poster.jpg`} muted loop playsinline preload="none" data-auto></video><figcaption class="caption">named object: a fork</figcaption></figure>
        </div>
        <p>The oracle's threads give way to the visitor's over the four turns. The face first shows through on the third answer; by the end the oracle is wearing it.</p>
      </section>

      <!-- HOW IT WORKS -->
      <section id="how">
        <div class="section-divider"><span class="eyebrow">how it works</span></div>
        <h2 class="display-lg op-h2">Five machines, one conversation.</h2>

        <div class="op-panel">
          <div class="op-rv">
            <span class="op-num">01 · listening</span>
            <h3 class="display-md">It hears <em>how</em> you speak.</h3>
            <p>Every answer is recorded and measured: how loud you are, how much the loudness surges, how long you pause, how high your voice sits and how much it moves. Each number is ranked against every visitor who came before you. After the fourth answer, the nearest of eight voice profiles becomes your mark.</p>
            <p>A quiet voice full of pauses tends toward The Sky Eye. A loud, surging one toward The Thorns. Say the same words in a different way and you leave a different mark.</p>
            <span class="op-tools">python · signal measures ranked against past visitors</span>
          </div>
          <div class="op-viz op-rv"><span class="op-label">voice · live</span><canvas data-fx="voice" width="800" height="1000"></canvas></div>
        </div>

        <div class="op-panel">
          <div class="op-rv">
            <span class="op-num">02 · thinking</span>
            <h3 class="display-md">It thinks without the internet.</h3>
            <p>Speech becomes text, a language model writes the oracle's reply, and a synthetic voice speaks it, all on the installation's own computer. The conversation never leaves the room. The oracle is also told how you sounded, so its last words touch on your voice as well as your answers.</p>
            <span class="op-tools">vosk · gemma 3 4b via ollama · kittentts</span>
          </div>
          <div class="op-viz op-rv"><span class="op-label">local · offline</span><div class="op-term" data-fx="term"></div></div>
        </div>

        <div class="op-panel">
          <div class="op-rv">
            <span class="op-num">03 · weaving</span>
            <h3 class="display-md">It is woven, not played.</h3>
            <p>The oracle is not a video. Its figure is rebuilt from threads every frame in a GLSL shader, and the threads loosen when it speaks. Over the four turns the visitor's portrait is woven in, thread by thread, in the oracle's place.</p>
            <span class="op-tools">touchdesigner · glsl</span>
          </div>
          <div class="op-viz op-rv"><span class="op-label">weave</span><canvas data-fx="loom" width="800" height="1000"></canvas></div>
        </div>

        <div class="op-panel">
          <div class="op-rv">
            <span class="op-num">04 · dressing</span>
            <h3 class="display-md">It dresses you for the road.</h3>
            <p>This is the one step that goes online. Your photo, cropped to your face, and the object you named go to an image model, which returns you as a traveller of the road: a patchwork coat, a boxcar wall with chalk marks, and your object held larger than life. The object is how people recognise themselves.</p>
            <span class="op-tools">google nano-banana via replicate · opencv face crop</span>
          </div>
          <div class="op-viz op-rv"><span class="op-label">portrait</span><img class="op-fill" data-fx="portrait" alt="Portraits generated at the exhibition: travellers in patchwork coats holding a ladder, flowers and a rabbit" /><canvas data-fx="scan" width="800" height="1000"></canvas></div>
        </div>

        <div class="op-panel">
          <div class="op-rv">
            <span class="op-num">05 · drawing</span>
            <h3 class="display-md">A rescued machine draws your mark.</h3>
            <p>A small neural network, trained on 1,440 recordings of actors performing emotion, turns the voice readings into the character of the line: its weight, curve, noise and density. Two people with the same symbol never leave the same drawing.</p>
            <p>The plotter began as a broken laser engraver someone threw away. Andrey Dyakov took it apart, rebuilt it with open-source firmware and gave it a pen. It draws each mark line by line onto the collective cloth. It does not print.</p>
            <span class="op-tools">mlp (ravdess) → onnx · rebuilt neje engraver</span>
          </div>
          <div class="op-viz op-rv"><span class="op-label">plotter · pen down</span><canvas data-fx="plotter" width="800" height="1000"></canvas></div>
        </div>
      </section>

      <!-- MARKS -->
      <section id="marks">
        <div class="section-divider"><span class="eyebrow">the eight marks</span></div>
        <h2 class="display-lg op-h2">A code left for whoever comes next.</h2>
        <p>Eight signs adapted from the travellers' chalk code. Your voice decides which one you receive; our custom-trained model decides how its line is drawn.</p>
        <div class="op-marks" id="marksGrid"></div>
      </section>

      <!-- PROCESS -->
      <section id="process">
        <div class="section-divider"><span class="eyebrow">process</span></div>
        <h2 class="display-lg op-h2">What user testing changed.</h2>
        <p>Oracle went through several rounds of user testing in the spring, then a rebuild for the exhibition. The biggest changes answered one question: could a visitor tell what the oracle was doing, and find themselves in the result?</p>
        <div class="op-iters">
          <div class="op-iter op-rv">
            <span class="op-round">early testing</span>
            <h3 class="display-md">The oracle leads the conversation.</h3>
            <p><span>we saw</span>Faced with an open-ended chat, visitors did not know what to say to an oracle.</p>
            <p><span>we changed</span>The oracle now guides a fixed arc. It asks for an object, then asks a question that turns that object back to the visitor so they can reflect, and it closes on what they would leave for the people who come after them, bringing the conversation back to the collective cloth.</p>
          </div>
          <div class="op-iter op-rv">
            <span class="op-round">round 3 → 4</span>
            <h3 class="display-md">The system admits it is listening.</h3>
            <p><span>we saw</span>Visitors could not tell whether the microphone was on. The listening ring pulsed at a fixed rate whether they spoke or not.</p>
            <p><span>we changed</span>The ring is now driven by the live loudness of the voice. It swells when you speak and falls still when you stop.</p>
            <div class="op-rings"><div class="op-ring fixed"></div><div class="op-ring live"></div></div>
          </div>
          <div class="op-iter op-rv">
            <span class="op-round">round 4</span>
            <h3 class="display-md">A face you can still find yourself in.</h3>
            <p><span>we saw</span>Pasting the visitor's face onto the oracle read as a glitch, not a transformation. It felt fragile and distant.</p>
            <p><span>we changed</span>An image model now redraws the visitor while keeping their likeness. When the portrait appeared, testers who had been unsure went still and leaned in.</p>
          </div>
          <div class="op-iter op-rv">
            <span class="op-round">round 4</span>
            <h3 class="display-md">The object comes back to you.</h3>
            <p><span>we saw</span>A visitor would name a compass and receive a portrait with no compass in it. The conversation and the image did not connect.</p>
            <p><span>we changed</span>The named object now travels from speech into the portrait and the receipt. It became how visitors recognise themselves.</p>
          </div>
        </div>
      </section>

    </div>

    <!-- CREDITS -->
    <section class="project-meta">
      <div class="meta-row"><span class="meta-label">nadine allan</span><span class="meta-value">Concept and narrative. The Oracle system: interaction design, TouchDesigner visuals and shaders, the agentic AI and voice pipeline, the portraits.</span></div>
      <div class="meta-row"><span class="meta-label">andrey dyakov</span><span class="meta-value">The robotic plotter: rebuild and firmware. The online collective cloth.</span></div>
      <div class="meta-row"><span class="meta-label">exhibited</span><span class="meta-value">PROTO 26 · IADE Fashion Show · Oriente Green Campus, Lisbon · 25.09.2026</span></div>
      <div class="meta-row"><span class="meta-label">tools</span><span class="meta-value">TouchDesigner 2025, GLSL · Vosk · Gemma 3 4B via Ollama · KittenTTS · Google nano-banana via Replicate · MLP trained on RAVDESS, ONNX · rebuilt NEJE engraver · Flutter web, Firebase</span></div>
      <div class="meta-row"><span class="meta-label">privacy</span><span class="meta-value">Voice recordings and photos stay on the installation computer and are deleted after each exhibition. The photo leaves the machine once, to make the portrait. Only the drawn mark and the receipt text are archived online.</span></div>
      <div class="meta-row"><span class="meta-label">context</span><span class="meta-value">IADE M-CCIA · Lisbon, 2026</span></div>
    </section>

  </article>
</BaseLayout>

<script is:inline>
(() => {
  const IMG = '/images/oracle/exhibition';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // colours come from the site's tokens: the screens are ink, the lines paper, the accent gold
  const css = getComputedStyle(document.documentElement);
  const INK = css.getPropertyValue('--ink').trim() || '#2a2620';
  const PAPER = css.getPropertyValue('--bg').trim() || '#f4f0e9';
  const GOLD = css.getPropertyValue('--gold-light').trim() || '#b8983f';
  const rgba = (hex, a) => { const n = parseInt(hex.slice(1), 16); return `rgba(${n >> 16},${(n >> 8) & 255},${n & 255},${a})`; };

  const SYMS = ['the_thorns','the_sky_eye','the_shriek','the_pitiful_story','the_kind_soul','the_watcher','the_bitter_root','the_horizon'];
  const MARKS = {
    the_thorns: ['The Thorns', 'Something you are still holding on to, even though it scratches.', 'loud · surging · few pauses'],
    the_sky_eye: ['The Sky Eye', 'You watch something from a distance and have not moved toward it yet.', 'quiet · many pauses · flat pitch'],
    the_shriek: ['The Shriek', 'Something you have not said out loud, to anyone.', 'surging · high · pitch moving a lot'],
    the_pitiful_story: ['The Pitiful Story', 'The story you tell yourself about why something happened.', 'even · almost no pauses · talking it through'],
    the_kind_soul: ['The Kind Soul', 'You give more than you receive, and you have decided this is fine.', 'softer · even · lower-middle pitch'],
    the_watcher: ['The Watcher', 'You see clearly what others miss. That clarity has a cost.', 'very even · some pauses · flat pitch'],
    the_bitter_root: ['The Bitter Root', 'Something from long ago still shapes what you do now.', 'low pitch · pauses · quite flat'],
    the_horizon: ['The Horizon', 'You are at the edge of something new, deciding whether to step forward.', 'louder · higher · rising and falling'],
  };
  const PORTRAITS = [`${IMG}/portrait_20260925_150810.jpg`, `${IMG}/portrait_20260925_150558.jpg`, `${IMG}/portrait_20260925_150119.jpg`, `${IMG}/reveal_rock_25s.jpg`];
  const ease = t => t < 0 ? 0 : t > 1 ? 1 : t * t * (3 - 2 * t);
  let PATHS = {};

  // plot a symbol's pen paths up to progress 0..1 (paths live in a 600 x 300 box)
  function plot(cx, name, prog, ox, oy, sc, color, lw, pen) {
    const paths = PATHS[name]; if (!paths) return null;
    const total = paths.reduce((a, p) => a + p.length, 0);
    let left = Math.floor(total * Math.min(1, prog)), head = null;
    cx.strokeStyle = color; cx.lineWidth = lw; cx.lineCap = 'round'; cx.lineJoin = 'round';
    for (const p of paths) {
      if (left <= 0) break;
      const n = Math.min(p.length, left); left -= n;
      cx.beginPath();
      for (let i = 0; i < n; i++) { const x = ox + p[i][0] * sc, y = oy + p[i][1] * sc; i ? cx.lineTo(x, y) : cx.moveTo(x, y); head = [x, y]; }
      cx.stroke();
    }
    if (pen && head && prog < 1) {
      cx.strokeStyle = GOLD; cx.lineWidth = 2;
      cx.beginPath(); cx.arc(head[0], head[1], 12, 0, 6.283); cx.stroke();
      cx.beginPath(); cx.moveTo(head[0] - 34, head[1]); cx.lineTo(head[0] + 34, head[1]); cx.moveTo(head[0], head[1] - 34); cx.lineTo(head[0], head[1] + 34); cx.stroke();
    }
    return head;
  }

  // panel animations; t = seconds since the panel came into view
  const FX = {
    voice(cx, t, st) {
      const loop = 14, tt = t % loop;
      if (tt < st.last) st.pick = SYMS[Math.floor(Math.random() * 8)];
      st.last = tt;
      cx.strokeStyle = rgba(PAPER, 0.85); cx.lineWidth = 2; cx.beginPath();
      for (let i = 0; i <= 700; i += 3) {
        const a = t * 3 + i / 80, env = Math.max(0, Math.sin(a * 0.9) * 0.8 + Math.sin(a * 2.3) * 0.4) ** 1.5;
        const v = env * (Math.sin(i * 0.35 + t * 40) * 0.6 + Math.sin(i * 0.9 + t * 23) * 0.4) * 80;
        i ? cx.lineTo(50 + i, 170 + v) : cx.moveTo(50 + i, 170 + v);
      }
      cx.stroke();
      cx.font = '18px "IBM Plex Mono", monospace';
      ['LOUDNESS', 'SWING', 'PAUSES', 'PITCH', 'PITCH MOVE'].forEach((n, k) => {
        const v = 0.5 + 0.38 * Math.sin(t * (0.9 + k * 0.37) + k * 2) * Math.cos(t * 0.31 + k), y = 320 + k * 54;
        cx.fillStyle = rgba(PAPER, 0.6); cx.fillText(n, 50, y + 6);
        cx.fillStyle = rgba(PAPER, 0.16); cx.fillRect(250, y - 4, 400, 8);
        cx.fillStyle = PAPER; cx.fillRect(250, y - 4, 400 * v, 8);
        cx.fillText(v.toFixed(2), 680, y + 6);
      });
      const k = tt < 5 ? -1 : tt < 8 ? Math.floor(((tt - 5) ** 1.6) * 6) % 8 : SYMS.indexOf(st.pick);
      SYMS.forEach((s, i) => {
        const x = 50 + i * 88, y = 600;
        cx.strokeStyle = i === k ? (tt >= 8 ? PAPER : GOLD) : rgba(PAPER, 0.16); cx.lineWidth = i === k ? 2 : 1;
        cx.strokeRect(x, y, 80, 56);
        plot(cx, s, 1, x + 6, y + 6, 0.114, rgba(PAPER, 0.85), 1.3, false);
      });
      if (tt >= 8) {
        plot(cx, st.pick, ease((tt - 8) / 3.5), 100, 700, 1.0, PAPER, 3, true);
        cx.fillStyle = GOLD; cx.fillText('[VOICE] chose ' + st.pick, 50, 960);
      }
    },
    loom(cx, t) {
      const x0 = 60, x1 = 740, y0 = 70, y1 = 940, step = 16, rows = Math.floor((y1 - y0) / 13);
      cx.lineWidth = 1;
      for (let x = x0; x <= x1; x += step) { cx.strokeStyle = rgba(PAPER, 0.14); cx.beginPath(); cx.moveTo(x, y0); cx.lineTo(x, y1); cx.stroke(); }
      const done = Math.min(rows, (t % 22) * 6);
      for (let r = 0; r < done; r++) {
        const y = y0 + r * 13, part = Math.min(1, done - r), xe = x0 + (x1 - x0) * part;
        cx.strokeStyle = r % 9 === 4 ? rgba(GOLD, 0.7) : rgba(PAPER, 0.34);
        cx.beginPath();
        for (let x = x0; x <= xe; x += step) { const up = ((x - x0) / step + r) % 2 ? -2 : 2; x === x0 ? cx.moveTo(x, y + up) : cx.lineTo(x, y + up); }
        cx.stroke();
        if (part < 1) { cx.fillStyle = PAPER; cx.fillRect(xe - 5, y - 5, 10, 10); }
      }
      const s = SYMS[Math.floor(t / 22) % 8], p = ease(((t % 22) - 7) / 7);
      plot(cx, s, p, 100, 360, 1.0, INK, 9, false);
      plot(cx, s, p, 100, 360, 1.0, PAPER, 3.5, true);
    },
    plotter(cx, t) {
      const x0 = 40, y0 = 40, w = 720, h = 920;
      cx.strokeStyle = rgba(PAPER, 0.07); cx.lineWidth = 1;
      for (let x = x0; x < x0 + w; x += 6) { cx.beginPath(); cx.moveTo(x, y0); cx.lineTo(x, y0 + h); cx.stroke(); }
      for (let y = y0; y < y0 + h; y += 6) { cx.beginPath(); cx.moveTo(x0, y); cx.lineTo(x0 + w, y); cx.stroke(); }
      const loop = 13, s = SYMS[(Math.floor(t / loop) + 3) % 8], pr = ease((t % loop) / 10);
      const head = plot(cx, s, pr, 70, 330, 1.1, PAPER, 3.5, true);
      cx.font = '17px "IBM Plex Mono", monospace'; cx.fillStyle = rgba(PAPER, 0.6);
      if (head) cx.fillText(`PLOTTING ${s}   X ${((head[0] - x0) / 3).toFixed(1)}mm  Y ${((head[1] - y0) / 3).toFixed(1)}mm  ${Math.round(pr * 100)}%`, 50, 930);
    },
    scan(cx, t, st) {
      const seg = Math.floor(t / 4.5);
      if (seg !== st.seg) { st.seg = seg; st.img.src = PORTRAITS[seg % PORTRAITS.length]; }
      const p = ease((t % 4.5) / 2.6), y = p * 1000;
      st.img.style.clipPath = `inset(0 0 ${100 - p * 100}% 0)`;
      for (let yy = 0; yy < y; yy += 7) { cx.fillStyle = rgba(INK, 0.28); cx.fillRect(0, yy, 800, 2); }
      if (p < 1) { cx.fillStyle = PAPER; cx.shadowColor = GOLD; cx.shadowBlur = 30; cx.fillRect(0, y - 2, 800, 4); cx.shadowBlur = 0; }
    },
  };

  // what the real servers print
  const TERM = [
    ['d', '$ oracle --local'],
    ['t', '[STT]    listening… 7.4s of speech'],
    ['',  '[STT]    "a telephone"'],
    ['t', '[LLM]    gemma3:4b · on this machine'],
    ['d', '[NET]    0 bytes sent'],
    ['t', '[VOICE]  loudness 0.42  pauses 0.71  pitch 0.33'],
    ['g', '[VOICE]  chose the_sky_eye · voice sounded quiet, full of pauses'],
    ['t', '[TTS]    speaking…'],
    ['',  '         "The wires hum with the weight of unanswered questions."'],
  ];
  function runTerm(el) {
    el.innerHTML = ''; let li = 0, ci = 0, line = null;
    const step = () => {
      if (li >= TERM.length) { el.insertAdjacentHTML('beforeend', '<span class="op-cursor"></span>'); setTimeout(() => runTerm(el), 5000); return; }
      if (!line) { line = document.createElement('div'); line.className = TERM[li][0]; el.appendChild(line); }
      line.textContent = TERM[li][1].slice(0, ++ci);
      if (ci >= TERM[li][1].length) { li++; ci = 0; line = null; setTimeout(step, 280); } else setTimeout(step, 22);
    };
    setTimeout(step, 500);
  }

  // run each canvas only while it is on screen
  const live = new Map();
  function startFx(canvas) {
    const name = canvas.dataset.fx, cx = canvas.getContext('2d'), st = { last: 99, pick: 'the_sky_eye', seg: -1 };
    if (name === 'scan') st.img = canvas.parentElement.querySelector('img[data-fx=portrait]');
    const t0 = performance.now();
    const frame = now => {
      if (!live.get(canvas)) return;
      cx.clearRect(0, 0, canvas.width, canvas.height);
      FX[name](cx, reduce ? 30 : (now - t0) / 1000, st);
      if (!reduce) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
  function drawMark(c) {
    const cx = c.getContext('2d'), name = c.dataset.mark, t0 = performance.now();
    const f = now => {
      const p = reduce ? 1 : ease((now - t0) / 2600);
      cx.clearRect(0, 0, c.width, c.height);
      plot(cx, name, p, 0, 0, 1, INK, 3, true);
      if (p < 1) requestAnimationFrame(f);
    };
    requestAnimationFrame(f);
  }
  const io = new IntersectionObserver(entries => {
    for (const e of entries) {
      const el = e.target;
      if (el.classList.contains('op-rv') && e.isIntersecting) el.classList.add('in');
      if (el.tagName === 'CANVAS' && el.dataset.fx) {
        const was = live.get(el); live.set(el, e.isIntersecting);
        if (e.isIntersecting && !was) startFx(el);
      }
      if (el.classList.contains('op-term') && e.isIntersecting && !el.dataset.run) { el.dataset.run = 1; runTerm(el); }
      if (el.tagName === 'VIDEO' && el.hasAttribute('data-auto')) { e.isIntersecting ? el.play().catch(() => {}) : el.pause(); }
      if (el.tagName === 'CANVAS' && el.dataset.mark && e.isIntersecting && !el.dataset.done) { el.dataset.done = 1; drawMark(el); }
    }
  }, { threshold: 0.05 });

  // session video: autoplays muted, sound on request
  const sv = document.getElementById('sessionVid'), sb = document.getElementById('soundBtn');
  sb.addEventListener('click', () => {
    sv.muted = !sv.muted;
    if (!sv.muted) { sv.currentTime = 0; sv.play(); }
    sb.textContent = sv.muted ? 'sound off · tap for sound' : 'sound on · tap to mute';
  });

  const grid = document.getElementById('marksGrid');
  SYMS.forEach(s => {
    const [name, means, voice] = MARKS[s];
    grid.insertAdjacentHTML('beforeend', `<div class="op-mark op-rv"><canvas data-mark="${s}" width="600" height="300" aria-label="${name}"></canvas><h4 class="display-md">${name}</h4><p>${means}</p><span class="op-voice">${voice}</span></div>`);
  });
  // drifting threads: bright in the hero band, very faint behind the whole page
  function threads(c, count, colors) {
    const cx = c.getContext('2d');
    const TH = Array.from({ length: count }, (_, i) => ({ y: (i + 0.5) / count, a: 14 + Math.random() * 36, f: 0.002 + Math.random() * 0.003,
      sp: 0.15 + Math.random() * 0.35, ph: Math.random() * 6.28, c: i % 5 === 0 ? colors[1] : colors[0] }));
    const size = () => { c.width = c.offsetWidth; c.height = c.offsetHeight; };
    size(); addEventListener('resize', size);
    const frame = now => {
      cx.clearRect(0, 0, c.width, c.height); cx.lineWidth = 1.1;
      for (const th of TH) {
        cx.strokeStyle = th.c; cx.beginPath();
        for (let x = -10; x <= c.width + 10; x += 12) {
          const y = th.y * c.height + Math.sin(x * th.f + now * 0.001 * th.sp + th.ph) * th.a + Math.sin(x * th.f * 2.3 - now * 0.0006) * th.a * 0.3;
          x < 0 ? cx.moveTo(x, y) : cx.lineTo(x, y);
        }
        cx.stroke();
      }
      if (!reduce) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
  threads(document.querySelector('.op-hero-threads'), 12, [rgba(PAPER, 0.12), rgba(GOLD, 0.35)]);
  threads(document.querySelector('.op-page-threads'), 10, [rgba(INK, 0.045), rgba(GOLD, 0.12)]);

  // start the hero video even where autoplay was held back, and retry on the first touch
  const hv = document.getElementById('heroVid');
  const kick = () => { if (hv.paused) hv.play().catch(() => {}); };
  kick(); document.addEventListener('visibilitychange', kick); addEventListener('pointerdown', kick, { once: true });

  const watch = () => document.querySelectorAll('.op-rv, canvas[data-fx], .op-term, video[data-auto], canvas[data-mark]').forEach(el => io.observe(el));
  fetch(`${IMG}/symbol_paths.json`).then(r => r.json()).then(j => { PATHS = j; watch(); }).catch(watch);
})();
</script>

