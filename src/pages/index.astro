---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroSrc = '/images/fine-art/natural pigments/ink-collage-popo-catalogue_BG_removed.png';
const heroMaskStyle = `-webkit-mask-image:url('${heroSrc}'); mask-image:url('${heroSrc}');`;
---

<BaseLayout title="home">
  <section class="hero" style={`background-image:url('${heroSrc}')`}>
    <div class="hero-duotone" aria-hidden="true">
      <div class="hero-duotone-shadow" style={heroMaskStyle}></div>
      <div class="hero-duotone-highlight" style={heroMaskStyle}></div>
    </div>
    <div class="hero-text">
      <span class="eyebrow">artist & creative technologist — lisbon</span>
      <h1 class="display-xl hero-statement">
        What does a system do to a thing when it tries to understand it?
      </h1>
    </div>
  </section>

  <section class="page-footer">
    <hr class="rule" />
    <p class="bio">
      Based in Lisbon, completing an MA in Creative Computing and AI at IADE – Universidade Europeia. I work in installation, generative media, video, and sound — tracing what gets lost, added, or transformed in translation.
    </p>
    <div class="links-row">
      <a class="cta-link" href="/work">view all work →</a>
      <a class="cta-link" href="/about">about</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: calc(100vh - var(--nav-height));
    min-height: 480px;
    overflow: hidden;
    background-color: var(--bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-duotone {
    position: absolute;
    inset: 0;
    transition: opacity var(--transition-slow);
  }
  .hero:hover .hero-duotone {
    opacity: 0;
  }
  .hero-duotone-shadow,
  .hero-duotone-highlight {
    position: absolute;
    inset: 0;
    -webkit-mask-size: cover;
    mask-size: cover;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .hero-duotone-shadow {
    background: var(--duo-shadow);
    -webkit-mask-mode: alpha;
    mask-mode: alpha;
  }
  .hero-duotone-highlight {
    background: var(--duo-highlight);
    -webkit-mask-mode: luminance;
    mask-mode: luminance;
  }
  .hero-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-6) var(--page-padding-x);
    background: linear-gradient(to top, rgba(20, 17, 13, 0.78) 0%, rgba(20, 17, 13, 0.32) 60%, transparent 100%);
  }
  .hero-text .eyebrow {
    color: var(--gold-light);
  }
  .hero-statement {
    margin-top: var(--space-2);
    max-width: 640px;
    color: var(--bg);
  }

  .page-footer {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-padding-x) var(--space-7);
  }
  .page-footer .rule {
    margin-bottom: var(--space-4);
  }
  .bio {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--w-light);
    line-height: var(--lh-body);
    color: var(--mid);
    max-width: 560px;
    margin: 0;
  }
  .links-row {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 420px;
    }
    .hero-text {
      padding: var(--space-5) var(--page-padding-x-sm);
    }
    .page-footer {
      padding: var(--space-5) var(--page-padding-x-sm) var(--space-6);
    }
  }
</style>
